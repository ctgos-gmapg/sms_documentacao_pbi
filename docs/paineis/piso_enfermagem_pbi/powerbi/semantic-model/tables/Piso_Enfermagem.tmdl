	column Codigo_OS = IF(OR(Piso_Enfermagem[pe_organizacao_social] = "IGEDES", Piso_Enfermagem[pe_organizacao_social] = "IDEIAS"), 10040, IF(Piso_Enfermagem[pe_organizacao_social] = "VIVARIO", 264, IF(Piso_Enfermagem[pe_organizacao_social] = "SPDM", 263, IF(Piso_Enfermagem[pe_organizacao_social] = "GNOSIS", 9615, IF(Piso_Enfermagem[pe_organizacao_social] = "FAS", 265, IF(Piso_Enfermagem[pe_organizacao_social] = "CEJAM", 268, IF(Piso_Enfermagem[pe_organizacao_social] = "RIOSAUDE", 9612, 0)))))))
