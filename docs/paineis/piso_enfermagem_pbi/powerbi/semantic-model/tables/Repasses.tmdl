	column Codigo_OS = IF(Repasses[FAVORECIDO] = "IGEDES INSTITUTO DE GESTAO E DESENVOLVIMENTO (ANTIGO IDEIAS)", 10040, IF(Repasses[FAVORECIDO] = "VIVA RIO", 264, IF(Repasses[FAVORECIDO] = "SPDM", 263, IF(Repasses[FAVORECIDO] = "GNOSIS", 9615, IF(Repasses[FAVORECIDO] = "FAS (ANTIGAS CEPP E CEP28)", 265, IF(Repasses[FAVORECIDO] = "CEJAM", 268, IF(Repasses[FAVORECIDO] = "RIOSAÚDE", 9612, IF(Repasses[FAVORECIDO] = "CENTRO INTEGRADO DE ESTUDO E PROGRAMAS DE DESENVOLVIMENTO SUSTENTáVEL - CIEDS", 10358, 0))))))))
		formatString: 0
		lineageTag: 503948fb-fbd6-46ff-9a60-6a0dd531fae0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ID =
			
			VAR IdPadrao = Repasses[Codigo_OS] & Repasses[INSTRUMENTO] & FORMAT(Repasses[DATA DE PAGAMENTO], "yyyy-mm")
			RETURN
			    // Ajuste pontual: repasses do VIVA RIO 015/2023-TC pagos em nov/2023 entram na chave de dez/2023
			    IF(IdPadrao = "264015/2023-TC2023-11", "264015/2023-TC2023-12", IdPadrao)
		lineageTag: 7fbb82fd-897e-4afa-8288-c78670bbf95e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ano_Mes_Ref =
			
			VAR MesPagamento = DATE(YEAR(Repasses[DATA DE PAGAMENTO]), MONTH(Repasses[DATA DE PAGAMENTO]), 1)
			RETURN
			    IF(
			        ISBLANK(Repasses[DATA DE PAGAMENTO]),
			        BLANK(),
			        // Ajuste pontual: repasses do VIVA RIO 015/2023-TC pagos em nov/2023 contam em dez/2023
			        IF(
			            Repasses[Codigo_OS] = 264 && Repasses[INSTRUMENTO] = "015/2023-TC" && MesPagamento = DATE(2023, 11, 1),
			            DATE(2023, 12, 1),
			            MesPagamento
			        )
			    )
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: 8b6f8394-fad4-48e7-bd06-eb19b68fb81d
		summarizeBy: none

	column Chave_Contrato = Repasses[Codigo_OS] & "|" & Repasses[INSTRUMENTO]
		dataType: string
		lineageTag: 3f46fd0f-5115-48bf-9c5c-a4c8e2bf10ef
		summarizeBy: none

